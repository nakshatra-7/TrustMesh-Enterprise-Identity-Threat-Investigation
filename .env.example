# npm run setup creates .env with random local credentials; do not commit .env.
APP_URL=http://localhost:3000
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=trustmesh
KEYCLOAK_CONSOLE_ID=trustmesh-console
KEYCLOAK_READER_ID=trustmesh-reader
KEYCLOAK_CONSOLE_SECRET=generated-by-setup
KEYCLOAK_READER_SECRET=generated-by-setup
KEYCLOAK_ADMIN_PASSWORD=generated-by-setup
ANALYST_PASSWORD=generated-by-setup
EMPLOYEE_PASSWORD=generated-by-setup
POSTGRES_PASSWORD=generated-by-setup
DATABASE_URL=postgresql://trustmesh:generated-by-setup@localhost:55432/trustmesh
REDIS_URL=redis://localhost:56379
COOKIE_SECRET=generated-by-setup
# Optional: both are required to enable model-driven investigations. No silent fallback.
OPENAI_API_KEY=
OPENAI_MODEL=
